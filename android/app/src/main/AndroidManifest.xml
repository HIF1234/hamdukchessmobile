<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The local-WiFi (data-free) tournament feature runs a raw socket server/client on the
         phone's hotspot LAN (INTERNET covers local sockets too, despite the name). CAMERA is
         for scanning the host's QR code to join. RECORD_AUDIO is for "say move aloud". -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <application
        android:label="Hamduk Chess"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Challenge links shared on WhatsApp etc. open the app directly (Android App Links,
                 verified by https://play.chess.hamduk.com.ng/.well-known/assetlinks.json). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="play.chess.hamduk.com.ng" android:pathPrefix="/challenge/" />
                <!-- Email confirmation / magic-link / password-recovery redirects. Supabase's
                     own /auth/v1/verify redirects the browser here after verifying the token,
                     landing on this app link with the session in the URL; supabase_flutter
                     picks it up automatically (SupabaseAuth's built-in deep-link handling). -->
                <data android:scheme="https" android:host="play.chess.hamduk.com.ng" android:pathPrefix="/auth/callback" />
            </intent-filter>
            <!-- "Import a game": a .pgn shared from WhatsApp etc. lands here. No storage
                 permission needed -- the sending app grants read access to this one content://
                 URI as part of the share Intent itself; broad storage access isn't required.
                 .pgn has no registered MIME type, so apps send it as whichever generic type
                 they guess (observed: text/plain or application/octet-stream); both are
                 covered without opting into every file type share sheets offer. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>
        <!-- Home-screen widget: today's daily puzzle and streak (lib/core/home_widget_sync.dart
             pushes the data; see HamdukWidgetProvider.kt). -->
        <receiver android:name=".HamdukWidgetProvider" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/hamduk_widget_info" />
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
